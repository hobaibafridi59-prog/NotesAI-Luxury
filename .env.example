# Copy to .env and fill in real values. Never commit .env.
# chmod 600 .env

# Active provider: gemini (default) or openrouter
AI_PROVIDER=gemini

# Google Gemini (default provider)
GEMINI_API_KEY=
# Verified vision-capable default; override only with another supported model.
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenRouter (manual alternate; FREE vision models only)
OPENROUTER_API_KEY=
# Optional override. Must be a zero-priced vision model ending in ":free".
# Leave empty to let the backend discover and rank free models automatically.
# OPENROUTER_FREE_MODEL=dots-studio/dots-3-note-preview:free

# Smart Recreated PDF is temporarily free through SMART_FREE_MODE=True in
# app.py. No code or payment is required. To restore the paid gate later, set
# SMART_FREE_MODE=False, re-add the route checks, and configure:
# NOTESAI_PREMIUM_CODE=replace-with-a-long-private-code
# Legacy local-development override:
NOTESAI_PREMIUM_OPEN=0

# Runtime
NOTESAI_HOST=127.0.0.1
NOTESAI_PORT=3000
NOTESAI_DEBUG=0
# Required for remote settings changes; localhost is always allowed.
# NOTESAI_ADMIN_TOKEN=

# JWT signing secret for user authentication (access + refresh tokens).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# NOTESAI_JWT_SECRET=
